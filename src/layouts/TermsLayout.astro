---
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
    <article class="prose">
        <slot />
    </article>
</BaseLayout>

<style>
    .prose {
        max-width: 720px;
        margin: 0 auto;
        padding: 2rem 0;
    }

    .prose :global(h1) {
        font-family: var(--font-display);
        font-size: var(--text-2xl);
        font-weight: 800;
        color: var(--color-text);
        margin: 0 0 0.25rem;
    }

    .prose :global(h2) {
        font-family: var(--font-display);
        font-size: var(--text-lg);
        font-weight: 700;
        color: var(--color-text);
        margin: 2rem 0 0.75rem;
        padding-top: 0.5rem;
    }

    .prose :global(p) {
        font-size: var(--text-sm);
        line-height: 1.75;
        color: var(--color-text);
        margin: 0 0 0.875rem;
    }

    .prose :global(ul) {
        padding-left: 1.5rem;
        margin: 0 0 0.875rem;
        font-size: var(--text-sm);
        line-height: 1.75;
        color: var(--color-text);
    }

    .prose :global(li) {
        margin-bottom: 0.25rem;
    }

    .prose :global(hr) {
        border: none;
        border-top: 1px solid var(--color-border);
        margin: 1.5rem 0;
    }
</style>
