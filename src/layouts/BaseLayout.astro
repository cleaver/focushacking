---
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const siteUrl = Astro.site?.href ?? "https://focushacking.com";
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = image ?? `${siteUrl}favicon.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Focus Hacking</title>
    {description && <meta name="description" content={description} />}

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} — Focus Hacking`} />
    <meta property="og:description" content={description ?? "Evidence-graded directory of free focus and attention techniques."} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} — Focus Hacking`} />
    <meta name="twitter:description" content={description ?? "Evidence-graded directory of free focus and attention techniques."} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Focus Hacking — Research Digest" href="/rss.xml" />

    <!-- Blocking: prevent dark-mode FOUC — runs before first paint -->
    <script is:inline>
      (function() {
        var theme = localStorage.getItem("theme");
        if (!theme) {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <nav class="border-b" style="border-color: var(--color-border);">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href="/" class="text-lg font-bold tracking-tight" style="color: var(--color-accent);">
          ⚡ Focus Hacking
        </a>
        <div class="flex items-center gap-4">
          <a href="/" class="text-sm font-medium" style="color: var(--color-text-muted);">Techniques</a>
          <a href="/rss.xml" class="text-sm font-medium" style="color: var(--color-text-muted);">RSS</a>
          <button id="theme-toggle" class="cursor-pointer rounded-md p-1.5 text-sm" style="color: var(--color-text-muted);"
            aria-label="Toggle dark mode">
            <span id="theme-icon">🌙</span>
          </button>
        </div>
      </div>
    </nav>

    <main class="mx-auto max-w-6xl px-4 py-6">
      <slot />
    </main>

    <footer class="border-t py-6 text-center text-xs" style="color: var(--color-text-muted); border-color: var(--color-border);">
      Evidence-graded directory of focus techniques. Updated weekly via PubMed.
    </footer>

    <script>
      const toggle = document.getElementById("theme-toggle");
      const icon = document.getElementById("theme-icon");
      const html = document.documentElement;

      // Sync icon to current state (class already set by blocking head script)
      icon.textContent = html.classList.contains("dark") ? "☀️" : "🌙";

      toggle.addEventListener("click", () => {
        const next = html.classList.contains("dark") ? "light" : "dark";
        if (next === "dark") {
          html.classList.add("dark");
          icon.textContent = "☀️";
        } else {
          html.classList.remove("dark");
          icon.textContent = "🌙";
        }
        localStorage.setItem("theme", next);
      });
    </script>
  </body>
</html>
