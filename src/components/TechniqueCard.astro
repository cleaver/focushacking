---
export interface Props {
  technique: {
    id: string;
    slug: string;
    title: string;
    category: string;
    grade: string;
    grade_detail: string;
    difficulty: string;
    time_to_benefit: string;
    populations: string[];
    focus_facets: string[];
    summary: string;
  };
}

const { technique: t } = Astro.props;
---

<a href={`/techniques/${t.slug || t.id.replace(/\.md$/, "")}/`}
  class="card block rounded-xl border p-4 transition-all hover:shadow-md bg-surface border-default">
  <div class="flex items-start gap-3">
    <span class={`grade-badge grade-${t.grade}`}>{t.grade}</span>
    <div class="min-w-0 flex-1">
      <div class="font-semibold leading-snug">{t.title}</div>
      <div class="mt-0.5 text-xs text-muted">{t.category}</div>
      <div class="mt-2 text-xs leading-relaxed text-muted">
        {(t.summary || "").substring(0, 150)}{(t.summary || "").length > 150 ? "…" : ""}
      </div>
      <div class="mt-2 flex flex-wrap gap-1.5">
        <span class="rounded-full px-2 py-0.5 text-xs font-medium bg-accent-light text-accent">
          {({ beginner: "Beginner", intermediate: "Intermediate", advanced: "Advanced" })[t.difficulty] || "Beginner"}
        </span>
        <span class="rounded-full px-2 py-0.5 text-xs bg-border text-muted">
          {t.time_to_benefit || ""}
        </span>
      </div>
      <div class="mt-2 text-xs text-accent font-medium">View details →</div>
    </div>
  </div>
</a>
