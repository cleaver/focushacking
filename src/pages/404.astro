---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found">
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <h1 class="text-6xl font-bold text-muted">404</h1>
    <p class="mt-4 text-muted">Page not found — try browsing all techniques from the homepage.</p>
    <a href="/" class="mt-6 inline-flex items-center gap-1 rounded-lg px-4 py-2 text-sm font-medium text-white bg-accent">
      ← Back to all techniques
    </a>
  </div>
</BaseLayout>
