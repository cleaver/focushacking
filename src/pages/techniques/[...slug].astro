---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const techniques = await getCollection("techniques");
  return techniques.map((t) => ({
    params: { slug: t.data.slug || t.id.replace(/\.md$/, "") },
    props: { entry: t },
  }));
}

const { entry } = Astro.props;
const t = entry.data;
const { Content } = await render(entry);

const GRADES = {
  A: { label: "Strong Evidence", desc: "≥3 RCTs or large meta-analysis, consistent, moderate-to-large effect" },
  B: { label: "Good Evidence", desc: "≥2 RCTs or 1 meta-analysis, mostly consistent, small-to-moderate effect" },
  C: { label: "Limited Evidence", desc: "1-2 RCTs or mixed results, methodological limitations" },
  D: { label: "Weak Evidence", desc: "Primarily observational, self-report, or single underpowered study" },
  "?": { label: "Insufficient Evidence", desc: "No peer-reviewed evidence found" },
};
const gradeInfo = GRADES[t.grade] || GRADES["?"];

const DIFF = { beginner: "Beginner", intermediate: "Intermediate", advanced: "Advanced" };

const FACET_LABELS = {
  distraction_resistance: "Distraction Resistance",
  studying_learning: "Studying & Learning",
  deep_work_flow: "Deep Work & Flow",
  energy_recovery: "Energy & Recovery",
};
---

<BaseLayout title={t.title} description={t.summary || `${t.title} — ${gradeInfo.label}`}>
  <div class="modal-card-wrap">
    <!-- Back link -->
    <a href="/" class="modal-back-link">← Back to all techniques</a>

    <!-- Card -->
    <div class="modal-card">
      <!-- Header -->
      <div class="modal-header">
        <div class="modal-header-left">
          <span class={`modal-grade-badge grade-badge-${t.grade}`}>{t.grade}</span>
          <div class="modal-title-group">
            <span class="modal-category" data-category={t.category?.toLowerCase().replace(/\s+/g, "-")}>{t.category}</span>
            <h1 class="modal-title">{t.title}</h1>
          </div>
        </div>
      </div>

      <!-- Body -->
      <div class="modal-body">
        <!-- Meta chips -->
        <div class="modal-meta">
          <span class="modal-meta-chip">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            {t.time_to_benefit || "N/A"}
          </span>
          <span class="modal-meta-chip">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            {DIFF[t.difficulty] || "Beginner"}
          </span>
          <span class="modal-meta-chip">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            {t.total_papers || 0} studies tracked
          </span>
        </div>

        <!-- Summary / description -->
        {t.summary && <p class="modal-description">{t.summary}</p>}

        <!-- Grade detail -->
        {t.grade_detail && (
          <div class="modal-section">
            <h3 class="modal-section-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              Evidence Grade
            </h3>
            <div class="modal-grade-rationale">
              <span class={`grade-rationale-badge grade-badge-${t.grade}`}>{t.grade}</span>
              <div>
                <div class="grade-rationale-label">{gradeInfo.label}</div>
                <div class="grade-rationale-desc">{t.grade_detail}</div>
              </div>
            </div>
          </div>
        )}

        <!-- Populations -->
        {t.populations && t.populations.length > 0 && (
          <div class="modal-section">
            <h3 class="modal-section-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Studied in
            </h3>
            <div class="modal-tags">
              {t.populations.map((p) => (
                <span class="modal-tag modal-tag-accent">{p.replace(/_/g, " ")}</span>
              ))}
            </div>
          </div>
        )}

        <!-- Focus facets -->
        {t.focus_facets && t.focus_facets.length > 0 && (
          <div class="modal-section">
            <h3 class="modal-section-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
              Focus areas
            </h3>
            <div class="modal-tags">
              {t.focus_facets.map((f) => (
                <span class="modal-tag modal-tag-default">{FACET_LABELS[f] || f.replace(/_/g, " ")}</span>
              ))}
            </div>
          </div>
        )}

        <!-- Rendered markdown content -->
        <div class="modal-rendered-content">
          <Content />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* ── Card wrapper ────────────────────────────────── */
  .modal-card-wrap {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .modal-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    padding: 0.25rem 0;
  }

  .modal-back-link:hover {
    opacity: 0.8;
  }

  /* ── Card ────────────────────────────────────────── */
  .modal-card {
    width: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    box-shadow: 0 12px 40px color-mix(in oklab, rgb(0 0 0) 20%, transparent);
    overflow: hidden;
  }

  .dark .modal-card {
    box-shadow: 0 12px 40px color-mix(in oklab, rgb(0 0 0) 50%, transparent);
  }

  /* ── Header ──────────────────────────────────────── */
  .modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 1.5rem 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .modal-header-left {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .modal-grade-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
  }

  .grade-badge-A {
    background: var(--color-grade-a-hi);
    color: var(--color-grade-a);
  }

  .grade-badge-B {
    background: var(--color-grade-b-hi);
    color: var(--color-grade-b);
  }

  .grade-badge-C {
    background: var(--color-grade-c-hi);
    color: var(--color-grade-c);
  }

  .grade-badge-D {
    background: var(--color-grade-d-hi);
    color: var(--color-grade-d);
  }

  .grade-badge-\? {
    background: var(--color-grade-na-hi);
    color: var(--color-grade-na);
  }

  .modal-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .modal-category {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
    padding: 2px 10px;
    border-radius: 9999px;
    align-self: flex-start;
  }

  .modal-category[data-category] {
    background: var(--color-accent-light);
    color: var(--color-accent);
  }

  .modal-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 0;
    line-height: 1.2;
  }

  /* ── Body ────────────────────────────────────────── */
  .modal-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* ── Meta chips ──────────────────────────────────── */
  .modal-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .modal-meta-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-surface-2);
  }

  .modal-meta-chip svg {
    opacity: 0.7;
    flex-shrink: 0;
  }

  /* ── Description ─────────────────────────────────── */
  .modal-description {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text);
    margin: 0;
  }

  /* ── Section ─────────────────────────────────────── */
  .modal-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .modal-section-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
    margin: 0;
  }

  .modal-section-title svg {
    opacity: 0.7;
    flex-shrink: 0;
  }

  /* ── Grade rationale ─────────────────────────────── */
  .modal-grade-rationale {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
  }

  .grade-rationale-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 800;
  }

  .grade-rationale-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.125rem;
  }

  .grade-rationale-desc {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* ── Tags ────────────────────────────────────────── */
  .modal-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .modal-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    font-size: var(--text-xs);
    font-weight: 600;
    border-radius: 9999px;
  }

  .modal-tag-accent {
    background: var(--color-accent-light);
    color: var(--color-accent);
  }

  .modal-tag-default {
    background: var(--color-surface-2);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }

  /* ── Rendered markdown (global — Content component) ─ */
  :global(.modal-rendered-content h2) {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
    margin: 0 0 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.modal-rendered-content p) {
    margin-bottom: 0.75rem;
    line-height: 1.7;
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  :global(.modal-rendered-content ul),
  :global(.modal-rendered-content ol) {
    padding-left: 1.25rem;
    margin-bottom: 0.75rem;
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  :global(.modal-rendered-content li) {
    margin-bottom: 0.375rem;
  }

  :global(.modal-rendered-content a) {
    color: var(--color-accent);
    text-decoration: underline;
    font-weight: 500;
  }

  :global(.modal-rendered-content a:hover) {
    opacity: 0.8;
  }

  :global(.modal-rendered-content blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    margin: 1rem 0;
    opacity: 0.8;
  }

  :global(.modal-rendered-content strong) {
    font-weight: 600;
  }

  /* ── Paper cards (rendered from markdown) ─────────── */
  :global(.modal-rendered-content > ol),
  :global(.modal-rendered-content > ul) {
    list-style: none;
    padding-left: 0;
  }

  :global(.modal-rendered-content > ol > li),
  :global(.modal-rendered-content > ul > li) {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1rem;
    margin-bottom: 0.75rem;
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  :global(.modal-rendered-content > ol > li > strong),
  :global(.modal-rendered-content > ul > li > strong) {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    margin-bottom: 0.25rem;
  }

  :global(.modal-rendered-content > ol > li ul),
  :global(.modal-rendered-content > ul > li ul) {
    list-style: none;
    padding: 0.5rem 0 0;
    margin: 0;
  }

  :global(.modal-rendered-content > ol > li ul li),
  :global(.modal-rendered-content > ul > li ul li) {
    background: none;
    border: none;
    border-radius: 0;
    padding: 0.125rem 0;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  :global(.modal-rendered-content > ol > li ul li a),
  :global(.modal-rendered-content > ul > li ul li a) {
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  :global(.modal-rendered-content > ol > li > em),
  :global(.modal-rendered-content > ul > li > em) {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: 9999px;
    font-style: normal;
    background: var(--color-accent-light);
    color: var(--color-accent);
    white-space: nowrap;
    margin-left: 0.25rem;
  }

  :global(.modal-rendered-content h3) {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 1.5rem 0 0.75rem;
    padding: 0;
  }

  /* ── Responsive ──────────────────────────────────── */
  @media (max-width: 640px) {
    .modal-header {
      padding: 1rem 1rem 0.75rem;
    }

    .modal-body {
      padding: 1rem;
    }

    .modal-header-left {
      flex-direction: column;
    }

    .modal-grade-badge {
      width: 40px;
      height: 40px;
      font-size: var(--text-lg);
      border-radius: 0.5rem;
    }

    .modal-title {
      font-size: var(--text-lg);
    }
  }
</style>
