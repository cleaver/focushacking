---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import TechniqueCard from "../components/TechniqueCard.astro";

const techniques = await getCollection("techniques");
const all = techniques
  .map((t) => ({ id: t.id, slug: t.data.slug, ...t.data }))
  .sort((a, b) => a.title.localeCompare(b.title));

const categories = [...new Set(all.map((t) => t.category))].sort();
const facets = [
  ["distraction_resistance", "Distraction Resistance"],
  ["studying_learning", "Studying & Learning"],
  ["deep_work_flow", "Deep Work & Flow"],
  ["energy_recovery", "Energy & Recovery"],
];
const populations = [
  ["general_adults", "General Adults"],
  ["students", "Students"],
  ["knowledge_workers", "Knowledge Workers"],
  ["clinical", "Clinical"],
  ["athletes", "Athletes"],
  ["children_adolescents", "Children & Adolescents"],
];
const grades = ["A", "B", "C", "D", "?"];
const difficulties = ["beginner", "intermediate", "advanced"];

const jsonData = JSON.stringify(all.map((t) => ({
  id: t.id,
  slug: t.slug,
  title: t.title,
  category: t.category,
  grade: t.grade,
  summary: t.summary || "",
  difficulty: t.difficulty || "beginner",
  time_to_benefit: t.time_to_benefit || "",
  populations: t.populations || [],
  focus_facets: t.focus_facets || [],
})));
---

<BaseLayout title="Focus Hacking" description="Evidence-graded directory of 58 free focus and attention techniques. Each technique graded A–D based on peer-reviewed research.">
  <div class="mb-6">
    <h1 class="text-3xl font-bold tracking-tight">Focus Hacking</h1>
    <p class="mt-1 text-muted">
      Evidence-graded directory of {all.length} free focus techniques.
      Each grade links to real peer-reviewed studies.
    </p>
  </div>

  <!-- Stats bar -->
  <div class="stats-bar">
    <div class="stat-card">
      <span class="stat-icon">📋</span>
      <div>
        <div class="stat-value">{all.length}</div>
        <div class="stat-label">Techniques</div>
      </div>
    </div>
    <div class="stat-card">
      <span class="stat-icon">🗂️</span>
      <div>
        <div class="stat-value">{categories.length}</div>
        <div class="stat-label">Categories</div>
      </div>
    </div>
    <div class="stat-card">
      <span class="stat-icon">📊</span>
      <div>
        <div class="stat-value">A–D</div>
        <div class="stat-label">Evidence Grades</div>
      </div>
    </div>
    <div class="stat-card">
      <span class="stat-icon">💯</span>
      <div>
        <div class="stat-value">100%</div>
        <div class="stat-label">Free</div>
      </div>
    </div>
  </div>

  <!-- Search + Controls -->
  <div class="mb-6 flex flex-wrap items-center gap-3">
    <input
      id="search"
      type="search"
      placeholder="Search techniques..."
      aria-label="Search techniques"
      class="flex-1 min-w-[200px] rounded-lg border px-3 py-2 text-sm outline-none bg-surface border-default text-default"
    />
    <select id="sort-select"
      aria-label="Sort techniques by"
      class="rounded-lg border px-3 py-2 text-sm outline-none bg-surface border-default text-default"
    >
      <option value="default">Default</option>
      <option value="grade-desc">Best evidence first</option>
      <option value="grade-asc">Weakest evidence first</option>
      <option value="name">Name A–Z</option>
      <option value="name-desc">Name Z–A</option>
      <option value="difficulty">Easiest first</option>
      <option value="time">Fastest benefit</option>
      <option value="category">Category</option>
    </select>
  </div>

  <!-- Filter pills -->
  <div class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted">
    Filter by category
  </div>
  <div class="mb-4 flex flex-wrap gap-2" id="category-filters">
    <button type="button" class="filter-pill active" data-group="category" data-value="all">
      All {all.length}
    </button>
    {categories.map((cat) => {
      const count = all.filter((t) => t.category === cat).length;
      const short = cat === "Time Management" ? "Time Mgmt" : cat;
      return (
        <button type="button" class="filter-pill" data-group="category" data-value={cat}>
          {short} ({count})
        </button>
      );
    })}
  </div>

  <div class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted">
    Filter by evidence grade
  </div>
  <div class="mb-4 flex flex-wrap gap-2" id="grade-filters">
    {grades.map((g) => {
      const count = all.filter((t) => t.grade === g).length;
      return (
        <button type="button" class="filter-pill" data-group="grade" data-value={g}>
          Grade {g} ({count})
        </button>
      );
    })}
  </div>

  <!-- Results info + controls -->
  <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
    <div id="result-count" class="text-xs text-muted">
      {all.length} of {all.length} techniques shown
    </div>
    <button id="clear-filters" type="button" class="text-xs font-medium text-accent bg-transparent border-none cursor-pointer p-0 hover:underline" aria-label="Clear all filters">
      Clear all filters
    </button>
  </div>

  <!-- Technique grid -->
  <div id="grid" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" aria-live="polite">
    {all.map((t) => <TechniqueCard technique={t} />)}
  </div>
</BaseLayout>

<div id="data-json" hidden set:html={jsonData}></div>

<script>
  const ALL = JSON.parse(document.getElementById("data-json").textContent);

  function syncPressed() {
    document.querySelectorAll(".filter-pill").forEach((b) => {
      b.setAttribute("aria-pressed", b.classList.contains("active"));
    });
  }

  function toggleFilter(btn) {
    const group = btn.dataset.group;
    const value = btn.dataset.value;
    const siblings = document.querySelectorAll(`.filter-pill[data-group="${group}"]`);

    if (value === "all") {
      siblings.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
    } else {
      const allBtn = document.querySelector(`.filter-pill[data-group="${group}"][data-value="all"]`);
      if (allBtn) allBtn.classList.remove("active");

      if (btn.classList.contains("active")) {
        btn.classList.remove("active");
        const active = document.querySelectorAll(`.filter-pill[data-group="${group}"].active`);
        if (active.length === 0 && allBtn) allBtn.classList.add("active");
      } else {
        btn.classList.add("active");
      }
    }
    syncPressed();
    filter();
  }

  function clearFilters() {
    document.getElementById("search").value = "";
    document.getElementById("sort-select").value = "default";
    document.querySelectorAll('.filter-pill[data-group="category"]').forEach((b) => {
      b.classList.toggle("active", b.dataset.value === "all");
    });
    document.querySelectorAll('.filter-pill[data-group="grade"]').forEach((b) => {
      b.classList.toggle("active", b.dataset.value === "all");
    });
    syncPressed();
    filter();
  }

  function updateResultCount(count, total) {
    const el = document.getElementById("result-count");
    if (el) el.textContent = count + " of " + total + " techniques shown";
  }

  function filter() {
    const query = (document.getElementById("search").value || "").toLowerCase();
    const sort = document.getElementById("sort-select").value;

    const activeCategories = [...document.querySelectorAll('.filter-pill[data-group="category"].active')]
      .map((b) => b.dataset.value)
      .filter((v) => v !== "all");
    const activeGrades = [...document.querySelectorAll('.filter-pill[data-group="grade"].active')]
      .map((b) => b.dataset.value)
      .filter((v) => v !== "all");

    let filtered = ALL.filter((t) => {
      if (activeCategories.length && !activeCategories.includes(t.category)) return false;
      if (activeGrades.length && !activeGrades.includes(t.grade)) return false;
      if (query && !t.title.toLowerCase().includes(query) && !(t.summary || "").toLowerCase().includes(query)) return false;
      return true;
    });

    const gradeOrder = { A: 0, B: 1, C: 2, D: 3, "?": 4 };
    const diffOrder = { beginner: 0, intermediate: 1, advanced: 2 };
    const timeOrder = { Immediate: 0, "1 week": 1, "1–2 weeks": 2, "2–4 weeks": 3, "4–6 weeks": 4, "4–8 weeks": 5 };
    switch (sort) {
      case "grade-desc": filtered.sort((a, b) => (gradeOrder[a.grade] ?? 4) - (gradeOrder[b.grade] ?? 4)); break;
      case "grade-asc": filtered.sort((a, b) => (gradeOrder[b.grade] ?? 4) - (gradeOrder[a.grade] ?? 4)); break;
      case "name": filtered.sort((a, b) => a.title.localeCompare(b.title)); break;
      case "name-desc": filtered.sort((a, b) => b.title.localeCompare(a.title)); break;
      case "difficulty": filtered.sort((a, b) => (diffOrder[a.difficulty] ?? 0) - (diffOrder[b.difficulty] ?? 0)); break;
      case "time": filtered.sort((a, b) => (timeOrder[a.time_to_benefit] ?? 99) - (timeOrder[b.time_to_benefit] ?? 99)); break;
      case "category": filtered.sort((a, b) => a.category.localeCompare(b.category) || a.title.localeCompare(b.title)); break;
    }

    updateResultCount(filtered.length, ALL.length);

    const grid = document.getElementById("grid");
    if (filtered.length === 0) {
      grid.innerHTML = `<div class="col-span-full py-12 text-center text-muted">No techniques match your filters.</div>`;
      return;
    }

    const diffs = { beginner: "Beginner", intermediate: "Intermediate", advanced: "Advanced" };
    grid.innerHTML = filtered.map((t) => {
      const slug = t.slug || t.id.replace(/\.md$/, "");
      return `<a href="/techniques/${slug}/" class="card block rounded-xl border p-4 transition-all hover:shadow-md bg-surface border-default">
        <div class="flex items-start gap-3">
          <span class="grade-badge grade-${t.grade}">${t.grade}</span>
          <div class="min-w-0 flex-1">
            <div class="font-semibold leading-snug">${t.title}</div>
            <div class="mt-0.5 text-xs text-muted">${t.category}</div>
            <div class="mt-2 text-xs leading-relaxed text-muted">
              ${(t.summary || "").substring(0, 150)}${(t.summary || "").length > 150 ? "…" : ""}
            </div>
            <div class="mt-2 flex flex-wrap gap-1.5">
              <span class="rounded-full px-2 py-0.5 text-[10px] font-medium bg-accent-light text-accent">${diffs[t.difficulty] || "Beginner"}</span>
              <span class="rounded-full px-2 py-0.5 text-[10px] bg-border text-muted">${t.time_to_benefit || ""}</span>
            </div>
          </div>
        </div>
      </a>`;
    }).join("");
  }

  // Attach event listeners (Astro scripts are modules — inline handlers not global)
  document.addEventListener("DOMContentLoaded", () => {
    document.getElementById("search").addEventListener("input", filter);
    document.getElementById("sort-select").addEventListener("change", filter);
    document.querySelectorAll(".filter-pill").forEach((btn) => {
      btn.addEventListener("click", () => toggleFilter(btn));
    });
    document.getElementById("clear-filters").addEventListener("click", clearFilters);
    syncPressed();
  });
</script>



<style>
  .filter-pill {
    background: var(--color-surface);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
  }
  @media (prefers-reduced-motion: no-preference) {
    .filter-pill {
      transition: all 0.15s;
    }
  }
  .filter-pill.active {
    background: var(--color-accent-light);
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Category pill colors — active */
  .filter-pill[data-group="category"][data-value="Time Management"].active { background: var(--color-cat-time); color: #fff; border-color: var(--color-cat-time); }
  .filter-pill[data-group="category"][data-value="Mindfulness"].active { background: var(--color-cat-mindfulness); color: #fff; border-color: var(--color-cat-mindfulness); }
  .filter-pill[data-group="category"][data-value="Breathing"].active { background: var(--color-cat-breathing); color: #fff; border-color: var(--color-cat-breathing); }
  .filter-pill[data-group="category"][data-value="Physical"].active { background: var(--color-cat-physical); color: #fff; border-color: var(--color-cat-physical); }
  .filter-pill[data-group="category"][data-value="Environment"].active { background: var(--color-cat-environment); color: #fff; border-color: var(--color-cat-environment); }
  .filter-pill[data-group="category"][data-value="Cognitive"].active { background: var(--color-cat-cognitive); color: #fff; border-color: var(--color-cat-cognitive); }
  .filter-pill[data-group="category"][data-value="Technology"].active { background: var(--color-cat-technology); color: #fff; border-color: var(--color-cat-technology); }

  /* Category pill colors — inactive (outlined) */
  .filter-pill[data-group="category"][data-value="Time Management"]:not(.active) { border-color: var(--color-cat-time); color: var(--color-cat-time); }
  .filter-pill[data-group="category"][data-value="Mindfulness"]:not(.active) { border-color: var(--color-cat-mindfulness); color: var(--color-cat-mindfulness); }
  .filter-pill[data-group="category"][data-value="Breathing"]:not(.active) { border-color: var(--color-cat-breathing); color: var(--color-cat-breathing); }
  .filter-pill[data-group="category"][data-value="Physical"]:not(.active) { border-color: var(--color-cat-physical); color: var(--color-cat-physical); }
  .filter-pill[data-group="category"][data-value="Environment"]:not(.active) { border-color: var(--color-cat-environment); color: var(--color-cat-environment); }
  .filter-pill[data-group="category"][data-value="Cognitive"]:not(.active) { border-color: var(--color-cat-cognitive); color: var(--color-cat-cognitive); }
  .filter-pill[data-group="category"][data-value="Technology"]:not(.active) { border-color: var(--color-cat-technology); color: var(--color-cat-technology); }

  /* Grade pills — active: filled with grade color */
  .filter-pill[data-group="grade"][data-value="A"].active { background: var(--color-grade-a); color: #fff; border-color: var(--color-grade-a); }
  .filter-pill[data-group="grade"][data-value="B"].active { background: var(--color-grade-b); color: #fff; border-color: var(--color-grade-b); }
  .filter-pill[data-group="grade"][data-value="C"].active { background: var(--color-grade-c); color: #fff; border-color: var(--color-grade-c); }
  .filter-pill[data-group="grade"][data-value="D"].active { background: var(--color-grade-d); color: #fff; border-color: var(--color-grade-d); }
  .filter-pill[data-group="grade"][data-value="?"].active { background: var(--color-grade-na); color: #fff; border-color: var(--color-grade-na); }

  /* Grade pills — inactive: outlined with grade color */
  .filter-pill[data-group="grade"][data-value="A"]:not(.active) { border-color: var(--color-grade-a); color: var(--color-grade-a); }
  .filter-pill[data-group="grade"][data-value="B"]:not(.active) { border-color: var(--color-grade-b); color: var(--color-grade-b); }
  .filter-pill[data-group="grade"][data-value="C"]:not(.active) { border-color: var(--color-grade-c); color: var(--color-grade-c); }
  .filter-pill[data-group="grade"][data-value="D"]:not(.active) { border-color: var(--color-grade-d); color: var(--color-grade-d); }
  .filter-pill[data-group="grade"][data-value="?"]:not(.active) { border-color: var(--color-grade-na); color: var(--color-grade-na); }
</style>
